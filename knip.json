{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreWorkspaces": ["packages/gate"],
  "workspaces": {
    ".": {
      "project": ["*.ts"],
      "ignoreDependencies": ["vibator"]
    },
    "packages/*": {
      "entry": ["src/index.ts", "src/rules/*.ts"],
      "project": ["src/**/*.ts"],
      "ignoreDependencies": [
        "@semantic-release/git",
        "semantic-release-monorepo"
      ]
    },
    "packages/create-gate": {
      "entry": ["src/cli.ts"],
      "project": ["src/**/*.ts"],
      "ignoreDependencies": [
        "@semantic-release/git",
        "semantic-release-monorepo"
      ]
    }
  }
}
