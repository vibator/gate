{
  "name": "vibator-plugins",
  "version": "1.0.0",
  "description": "Vibator plugins orchestrating other linters through their JavaScript APIs",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/biome",
    "packages/depcruise",
    "packages/knip",
    "packages/recommended",
    "packages/gate",
    "packages/create-gate",
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "lint": "biome check",
    "format": "biome format --write",
    "arch": "depcruise packages/*/src --config .dependency-cruiser.cjs",
    "knip": "knip",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "verify": "npm run lint && npm run arch && npm run knip && npm run typecheck && npm run test",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.0",
    "@types/node": "^26.3.0",
    "@vitest/coverage-v8": "^4.1.11",
    "dependency-cruiser": "^18.2.0",
    "husky": "^9.1.7",
    "knip": "^6.34.0",
    "typescript": "^6.0.3",
    "vibator": "^2.1.0",
    "vitest": "^4.1.10"
  }
}
