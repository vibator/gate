{
  "$schema": "https://unpkg.com/vibator@0.2.0/schema.json",
  "rules": {
    "no-conflict-markers": "error",
    "max-file-size": {
      "severity": "error",
      "exclude": ["package-lock.json", "pnpm-lock.yaml", "yarn.lock"],
      "options": {
        "maxKb": 400
      }
    },
    "no-dead-doc-links": "error",
    "tsdoc-coverage": {
      "severity": "error",
      "include": ["src/**/*.{ts,tsx}"],
      "exclude": ["**/*.test.*", "**/*.spec.*", "**/*.d.ts"]
    },
    "meaningful-names": {
      "severity": "error",
      "include": ["src/**/*.{ts,tsx,js,jsx}"],
      "exclude": ["**/*.test.*", "**/*.spec.*", "**/*.d.ts"]
    },
    "prefer-array-methods": {
      "severity": "warn",
      "include": ["src/**/*.{ts,tsx,js,jsx}"],
      "exclude": ["**/*.test.*", "**/*.spec.*", "**/*.d.ts"]
    },
    "no-deprecated-apis": {
      "severity": "error",
      "include": ["src/**/*.{ts,tsx}"],
      "exclude": ["**/*.d.ts"],
      "options": {
        "projects": ["tsconfig.json"]
      }
    }
  },
  "guidelines": {
    "docs/standards.md": [
      "tsdoc-coverage",
      "meaningful-names",
      "prefer-array-methods",
      "no-deprecated-apis"
    ]
  }
}
