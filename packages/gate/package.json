    "tsconfig.json",
    "docs",
    "skills",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@biomejs/biome": ">=2",
    "dependency-cruiser": ">=16",
    "typescript": ">=5.4 <7",
    "vibator": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "@biomejs/biome": {
      "optional": true
    },
    "dependency-cruiser": {
      "optional": true
    },
    "typescript": {
      "optional": true
    },
    "vibator": {
      "optional": true
    }
  }
